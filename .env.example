# OCL settings shared by every tool in this repository (tools/ocl_env.py).
#
#   cp .env.example .env              # default settings, ignored by Git
#   cp .env.example .env.local        # one file per instance, chosen with --env-file .env.local
#   chmod 600 .env .env.local         # the file can hold a token
#
# Only these two variables are read. A variable already exported in the shell wins over the file.
# Never commit a real token: every `.env*` file except this example is ignored by Git.

# Local instance (oclapi2 in Docker). HTTP is accepted only for localhost and *.localhost,
# and only with --allow-insecure-localhost.
OCL_API_URL=http://api.ocl.localhost

# Production, in a separate file such as .env.production (its own token; anonymous reads are disabled):
# OCL_API_URL=https://api.openconceptlab.org

# Token for the instance above. Leave empty here; fill it in your private copy only.
OCL_API_TOKEN=
