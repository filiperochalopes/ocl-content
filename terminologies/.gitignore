# Terminology translation assets (fetch on demand; licensed or large — keep out of Git)
*/*/assets/**/*.zip
*/*/assets/**/*.xml
*/*/assets/**/*.csv
!*/*/assets/README.md

# Generated working artifacts. Only the archive (*.zip) and bulkimport_audit.json are versioned:
# the parts and the bundle are byte-reproducible from the inputs the audit records, and the
# alignment report is a review surface rather than a kept record.
*/*/output/*.ndjson
*/*/output/*_part_*.zip
*/*/output/*.jsonl
*/*/output/alignment_report.csv
*/*/output/*.dev.audit.json
